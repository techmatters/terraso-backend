# Local development env file template.
#
# Save your filled-in copy at ~/secrets/terraso-backend/.env (NOT inside this
# repo). The Makefile and docker-compose.base.yml resolve env_file paths
# against $HOME/secrets/terraso-backend/.env.  Keeping the file outside the
# repo tree limits what AI assistants and other tools can read while browsing
# the project.
#
# DO NOT put real secrets in this file — it is committed to a PUBLIC repo.
# Use placeholders or empty values only; real values belong in your local
# ~/secrets/terraso-backend/.env (git-ignored) or the deploy dashboard.
#
# One-time setup:
#   mkdir -p ~/secrets/terraso-backend
#   cp env.sample ~/secrets/terraso-backend/.env
#   # then edit values
#
# Already have a .env and just want to adopt new keys from this template?
#   python3 scripts/refresh_env.py
# It backs up your current .env, rebuilds it from this file, and re-applies
# your existing values (keeping any commented alternates). See the script's
# header for details.

# ───────────────────────────── Core / Django ─────────────────────────────
ENV=development
DEBUG=True
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_CMD_ARGS=--worker-class gthread --threads 8
SECRET_KEY=super-sekret-that-must-be-changed-on-serious-environments
ALLOWED_HOSTS=*
PYTHONBREAKPOINT=ipdb.set_trace

# ───────────────────────────── Databases ─────────────────────────────
DATABASE_URL=postgres://postgres:postgres@db:5432/terraso_backend
DATABASE_EXTERNAL_PORT=5432
# Soil ID database: set SOIL_ID_DATABASE_ENABLED=false to skip starting the
# soil-id-db container entirely. Saves ~2 GB download and avoids pulling the
# container image. US soil matching still works; only global (HWSD) lookups
# need it. Default is true (included via Makefile).
# SOIL_ID_DATABASE_ENABLED=false
SOIL_ID_DATABASE_URL=postgres://postgres:postgres@soil-id-db:5432/soil_id
SOIL_ID_DATABASE_EXTERNAL_PORT=5433

# ───────────────────────────── Web client / CORS ─────────────────────────────
WEB_CLIENT_DOMAIN=127.0.0.1
WEB_CLIENT_PORT=3000
WEB_CLIENT_PROTOCOL=http
CORS_ORIGIN_WHITELIST=http://127.0.0.1:3000
# Django CSRF-trusted origins (comma-separated, scheme required).
# Default when unset: https://*.terraso.org
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000
API_ENDPOINT=http://127.0.0.1:8000

# ───────────────────────────── Auth / OAuth providers ─────────────────────────────
GOOGLE_CLIENT_ID=client-id
GOOGLE_CLIENT_SECRET=client-secret
GOOGLE_ANDROID_CLIENT_ID=google-mobile-client-id
GOOGLE_IOS_CLIENT_ID=google-mobile-client-id

APPLE_KEY_ID=your-apple-key-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_PRIVATE_KEY=your-apple-private-key
APPLE_CLIENT_ID=your-apple-client-id

MICROSOFT_CLIENT_ID=client-id
MICROSOFT_CLIENT_SECRET=client-secret
MICROSOFT_PRIVATE_KEY=private_key
# Must be hex — it is hex-decoded at startup (bytes.fromhex). Leave EMPTY if
# unused; a non-hex placeholder here crashes settings import (app won't start).
MICROSOFT_CERTIFICATE_THUMBPRINT=

# ───────────────────────────── JWT ─────────────────────────────
JWT_SECRET=superinsecuresecretchangeit
# Access tokens are short-lived bearer credentials; clients refresh on 401.
JWT_ACCESS_EXP_DELTA_SECONDS=7200
# Refresh tokens are rotated on each use, so this is a rolling cap on
# inactivity, not absolute session lifetime.
JWT_REFRESH_EXP_DELTA_SECONDS=2592000

# ═══════════════════════════ S3 / file storage ═══════════════════════════
# The backend talks to exactly ONE S3 target. Choose it by what you uncomment:
#   • everyday local dev  -> keep DEV/STAGING/PROD commented; use LOCAL SILO.
#   • app against real S3  -> uncomment exactly ONE of DEV/STAGING/PROD AND
#                             comment out the LOCAL SILO block (it overrides).
#
# scripts/copy_s3_to_local.py copies objects FROM a real-AWS env INTO the local
# silo. With the silo running, just run it: it prompts for the environment (or
# pass --from {dev,staging,prod}), reads THAT block's bucket names *even while
# commented*, prompts for the access key/secret only if the block doesn't have
# them, maps each bucket to the LOCAL SILO block by name, and auto-detects region.
# So DEV/STAGING/PROD can stay commented with no creds — just keep their bucket
# names filled in (commented is fine) so the script can read them. The block
# headers (# ─── DEV ───, # ─── LOCAL SILO ───, …) are how it finds each block,
# so keep them.
#
# TODO (follow-up): also let the copy script read creds from an AWS CLI profile
# (`aws configure --profile terraso-<env>`) so frequent copiers skip the prompt
# without storing keys in .env.
#
# Notes:
#   • AWS_S3_REGION_NAME is needed by the BACKEND when it talks to real S3. (The
#     copy script auto-detects region itself, so it's only here for the app.)
#   • Real-AWS buckets are dash-style -> AWS_S3_ADDRESSING_STYLE=virtual; the
#     local silo needs path-style.
#   • `files` (DATA_ENTRY_FILE_*) and `media` (STORY_MAP_MEDIA_*) are separate
#     settings even though they usually share a bucket — keep both.
#   • PUBLIC repo: fill real buckets / URLs / creds only in your
#     ~/secrets/.../.env copy, never here.

# ─── DEV (real AWS, us-east-1) ───  no corresponding render environment
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ADDRESSING_STYLE=virtual
# PROFILE_IMAGES_S3_BUCKET=terraso-dev-profile-images-332486111078-us-east-1-an
# PROFILE_IMAGES_BASE_URL=images.dev.terraso.org
# DATA_ENTRY_FILE_S3_BUCKET=terraso-dev-files-332486111078-us-east-1-an
# DATA_ENTRY_FILE_BASE_URL=files.dev.terraso.org
# STORY_MAP_MEDIA_S3_BUCKET=terraso-dev-files-332486111078-us-east-1-an
# STORY_MAP_MEDIA_BASE_URL=files.dev.terraso.org

# ─── STAGING (real AWS, us-east-2) ───  fill from Render "Backend -- staging"
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-2
# AWS_S3_ADDRESSING_STYLE=virtual
# PROFILE_IMAGES_S3_BUCKET=terraso-staging-images-332486111078-us-east-2-an
# PROFILE_IMAGES_BASE_URL=images.staging.terraso.net
# DATA_ENTRY_FILE_S3_BUCKET=terraso-staging-files-332486111078-us-east-2-an
# DATA_ENTRY_FILE_BASE_URL=files.staging.terraso.net
# STORY_MAP_MEDIA_S3_BUCKET=terraso-staging-files-332486111078-us-east-2-an
# STORY_MAP_MEDIA_BASE_URL=files.staging.terraso.net

# ─── PROD (real AWS) ───  fill from Render "Backend -- prod"
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-2
# AWS_S3_ADDRESSING_STYLE=virtual
# PROFILE_IMAGES_S3_BUCKET=terraso-prod-images-332486111078-us-east-2-an
# PROFILE_IMAGES_BASE_URL=images.terraso.org
# DATA_ENTRY_FILE_S3_BUCKET=terraso-prod-files-332486111078-us-east-2-an
# DATA_ENTRY_FILE_BASE_URL=files.terraso.org
# STORY_MAP_MEDIA_S3_BUCKET=terraso-prod-files-332486111078-us-east-2-an
# STORY_MAP_MEDIA_BASE_URL=files.terraso.org
# # backup + static live ONLY in prod — they're meaningless for local dev:
# #   DB_BACKUP_*  : used only by the DB backup/restore command (prod data).
# #   CDN_STATIC_* : Django's own collected static assets, read only when
# #                  DEBUG=False; local dev serves /static/ from disk.
# # NOTE: uncommenting this for a copy also makes s3-init create empty local
# # buckets for these (harmless). TODO: skip DB_BACKUP/CDN_STATIC in s3-init+copy.
# DB_BACKUP_S3_BUCKET=
# CDN_STATIC_S3_BUCKET=
# CDN_STATIC_DOMAIN=

# ─── LOCAL SILO (everyday dev — the usual default) ───
# Routes ALL S3 at the local silo; AWS_S3_ENDPOINT_URL also makes `make run`
# start the silo container. FILL IN <YOUR-LAN-IP> — use the machine's LAN IP,
# NOT localhost, so the web container and browser reach the same host:
#     macOS:  ipconfig getifaddr "$(route -n get default | awk '/interface:/{print $2}')"
#     Linux:  hostname -I | awk '{print $1}'
# Silo web console: http://localhost:9001 (log in with the creds below).
# Wipe ALL local silo data (buckets are recreated empty on the next `make run`):
#     docker rm -f terraso-backend-s3-1 terraso-backend-s3-init-1
#     docker volume rm terraso-backend_minio_data
# (To clear only the copy-target buckets instead, run
#  scripts/copy_s3_to_local.py --reset. The names above assume the repo dir is
#  'terraso-backend'; adjust the prefix if your clone is named differently.)
# Keep this block LAST so the copy script treats it as the destination.
AWS_S3_ENDPOINT_URL=http://<YOUR-LAN-IP>:9000
AWS_S3_ADDRESSING_STYLE=path
AWS_ACCESS_KEY_ID=terraso-local
AWS_SECRET_ACCESS_KEY=terraso-local-secret
PROFILE_IMAGES_S3_BUCKET=terraso-local-profile-images
DATA_ENTRY_FILE_S3_BUCKET=terraso-local-files
STORY_MAP_MEDIA_S3_BUCKET=terraso-local-files

# ─── DB restore (dev tool; safe defaults, independent of the S3 target) ───
ALLOW_RESTORE_FROM_BACKUP=false
DB_RESTORE_CONFIG_FILE=/etc/terraso/restore.conf

# ───────────────────────────── Email (AWS SES) ─────────────────────────────
AWS_SES_ACCESS_KEY_ID=aws-key-id
AWS_SES_SECRET_ACCESS_KEY=aws-secret-access-key

# ───────────────────────────── Integrations / analytics ─────────────────────────────
AIRTABLE_API_KEY=your-key-here
RENDER_API_TOKEN=your-render-token
MAPBOX_ACCESS_TOKEN=your-mapbox-token
PLAUSIBLE_URL=https://plausible.io/api/event

# Uncomment and populate with a DSN to enable Sentry.
# SENTRY_DSN=https://xyz.ingest.sentry.io/abcd

HUBSPOT_PORTAL_ID=98765
HUBSPOT_ACCOUNT_DELETION_FORM_ID=hubspot-form-uuid
HUBSPOT_AUTH_TOKEN="pat-xxxxxxx"
# Generally use True in local .env to not create real tickets.
# Default False in production & staging.
HUBSPOT_DRY_RUN=True

# PostHog product analytics (server-side). Disabled unless POSTHOG_ENABLED is
# true AND POSTHOG_API_KEY is set. Use the same project key as the mobile client.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=false

# ───────────────────────────── Misc ─────────────────────────────
# Export system - pagination size for GraphQL queries in export endpoints.
# Use 1 for testing to verify pagination works correctly.
EXPORT_PAGE_SIZE=50

# Controls verbosity of GraphQL operation logging in development (ENV="development" only).
# "minimal" - default Django structlog logging (no GraphQL-specific info)
# "names"   - include GraphQL operation name in request_started/request_finished logs
# "full"    - also include input variables (request_started) and response (request_finished)
GRAPHQL_LOG_LEVEL="names"

# Log output format: "json_formatter" (default, structured JSON — used in prod)
# or "plain_console" (human-readable, nicer for local dev).
LOGS_FORMATTER=plain_console
